next-env.d.ts
*.tsbuildinfo

# Local env files hold secrets; only the .example file is committed
.env*.local
.env

# Vercel CLI
.vercel/

# Logs and OS/editor junk
npm-debug.log*
.DS_Store
Thumbs.db
